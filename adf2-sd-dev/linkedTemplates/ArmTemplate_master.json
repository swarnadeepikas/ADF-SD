{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf2-sd-dev"
		},
		"ls_adls_source_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_source'"
		},
		"ls_source_sql_db_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_source_sql_db'"
		},
		"ls_sql_SystemIdentity_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_sql_SystemIdentity'",
			"defaultValue": "Integrated Security=False;Encrypt=True;Connection Timeout=30;Data Source=sqlserverdevsd.database.windows.net;Initial Catalog=sqldbdev"
		},
		"ls_target_sql_db_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_target_sql_db'"
		},
		"ls_AKV_sqlsource_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://adf-keyvault-sd-dev.vault.azure.net/"
		},
		"ls_RestService_reqres_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://reqres.in/api/users"
		},
		"ls_adls_source_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsgen2sdcontainer.dfs.core.windows.net"
		},
		"ls_source_sql_db_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserverdevsd2.database.windows.net"
		},
		"ls_source_sql_db_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqlserverdevsd"
		},
		"ls_source_sql_db_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "ssdeepika"
		},
		"ls_sql_keyvault_properties_typeProperties_connectionString_secretName": {
			"type": "string",
			"defaultValue": "secret-sqldb-sdeepika"
		},
		"ls_target_sql_db_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserverdevsd.database.windows.net"
		},
		"ls_target_sql_db_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "targetsqldbdev"
		},
		"ls_target_sql_db_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "ssdeepika"
		},
		"trigger_tumbling_window_properties_pipeline_parameters_StartDate": {
			"type": "string",
			"defaultValue": "@trigger().outputs.windowStartTime"
		},
		"trigger_tumbling_window_properties_pipeline_parameters_EndDate": {
			"type": "string",
			"defaultValue": "@trigger().outputs.windowEndTime"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf2-sd-dev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_source_accountKey": {
						"value": "[parameters('ls_adls_source_accountKey')]"
					},
					"ls_source_sql_db_password": {
						"value": "[parameters('ls_source_sql_db_password')]"
					},
					"ls_sql_SystemIdentity_connectionString": {
						"value": "[parameters('ls_sql_SystemIdentity_connectionString')]"
					},
					"ls_target_sql_db_password": {
						"value": "[parameters('ls_target_sql_db_password')]"
					},
					"ls_AKV_sqlsource_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_AKV_sqlsource_properties_typeProperties_baseUrl')]"
					},
					"ls_RestService_reqres_properties_typeProperties_url": {
						"value": "[parameters('ls_RestService_reqres_properties_typeProperties_url')]"
					},
					"ls_adls_source_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_source_properties_typeProperties_url')]"
					},
					"ls_source_sql_db_properties_typeProperties_server": {
						"value": "[parameters('ls_source_sql_db_properties_typeProperties_server')]"
					},
					"ls_source_sql_db_properties_typeProperties_database": {
						"value": "[parameters('ls_source_sql_db_properties_typeProperties_database')]"
					},
					"ls_source_sql_db_properties_typeProperties_userName": {
						"value": "[parameters('ls_source_sql_db_properties_typeProperties_userName')]"
					},
					"ls_target_sql_db_properties_typeProperties_server": {
						"value": "[parameters('ls_target_sql_db_properties_typeProperties_server')]"
					},
					"ls_target_sql_db_properties_typeProperties_database": {
						"value": "[parameters('ls_target_sql_db_properties_typeProperties_database')]"
					},
					"ls_target_sql_db_properties_typeProperties_userName": {
						"value": "[parameters('ls_target_sql_db_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf2-sd-dev_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf2-sd-dev_ArmTemplate_0')]"
			]
		},
		{
			"name": "adf2-sd-dev_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_sql_keyvault_properties_typeProperties_connectionString_secretName": {
						"value": "[parameters('ls_sql_keyvault_properties_typeProperties_connectionString_secretName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf2-sd-dev_ArmTemplate_1')]"
			]
		},
		{
			"name": "adf2-sd-dev_ArmTemplate_3",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_3.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"trigger_tumbling_window_properties_pipeline_parameters_StartDate": {
						"value": "[parameters('trigger_tumbling_window_properties_pipeline_parameters_StartDate')]"
					},
					"trigger_tumbling_window_properties_pipeline_parameters_EndDate": {
						"value": "[parameters('trigger_tumbling_window_properties_pipeline_parameters_EndDate')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf2-sd-dev_ArmTemplate_2')]"
			]
		}
	]
}