										{
											"name": "Set variable4",
											"type": "SetVariable",
											"dependsOn": [],
											"policy": {
												"secureOutput": false,
												"secureInput": false
											},
											"userProperties": [],
											"typeProperties": {
												"variableName": "outputVal",
												"value": "HR"
											}
										}
									]
								}
							],
